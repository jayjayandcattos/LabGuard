# Normalise line endings for text files; Git handles checkout conversion per platform.
* text=auto

*.php text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.sql text eol=lf
*.svg text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary
