# Copy this file to .env and fill in your local values.
# .env is gitignored — never commit real credentials.

# ── MariaDB (XAMPP defaults shown) ─────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=labguard
DB_USER=root
DB_PASSWORD=

# Connection string used by Prisma (Phase 3).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example with a password: mysql://root:mypassword@127.0.0.1:3306/labguard
DATABASE_URL="mysql://root:@127.0.0.1:3306/labguard"

# ── SMTP (Gmail app password — rotate the old ones!) ──────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-account@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-account@gmail.com
MAIL_FROM_NAME=LabGuard Attendance System
MAIL_ENCRYPTION=tls
MAIL_DEBUG=0

# ── Auth ───────────────────────────────────────────────────────
# Replace before deploying. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
